# Keep the build context small and free of data/artifacts.
.git/
.gitignore
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# Data and artifacts are mounted, never baked in.
data/
*.csv
models/*.joblib
models/*.pkl
mlruns/
mlflow.db

# Not needed at run time.
notebooks/
reports/
docs/
*.docx
